# RunbookOS Environment Configuration Example
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here

# PostgreSQL Database Configuration (PRIMARY & ONLY DATABASE)
# Local example: postgresql://postgres@localhost:5432/runbookos
# Production cloud example (Neon/Supabase/RDS): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres@localhost:5432/runbookos

# JWT Configuration (for REST API)
JWT_SECRET_KEY=your-jwt-secret-key
JWT_EXPIRATION_HOURS=24

# Groq API Configuration (Optional: AI features enabled only if configured)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
